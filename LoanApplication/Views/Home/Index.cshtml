@model List<LoanModel>


@{
    ViewData["Title"] = "Home Page";

    var rejectedLoans = TempData["rejectedLoans"];
    TempData.Keep("rejectedLoans");
    var acceptedLoans = TempData["acceptedLoans"];
    TempData.Keep("acceptedLoans");
    var noOfLoans = TempData["noOfLoans"];
    TempData.Keep("noOfLoans");


    /*Granted Loans Stats*/
    int loan80 = 0,
    loan85 = 0,
    loan90 = 0,
    loan95 = 0,
    loan97 = 0,
    loan100 = 0;


    foreach (var loanGranted in ViewBag.loansAllocated)
    {
        if(loanGranted == (decimal)80.00)
        {
            loan80 ++;
        }

        if (loanGranted == (decimal)85.00)
        {
            loan85 ++;
        }

        if (loanGranted == (decimal)90.00)
        {
            loan90 ++;
        }

        if (loanGranted == (decimal)95.00)
        {
            loan95 ++;
        }

        if (loanGranted == (decimal)97.5)
        {
            loan97 ++;
        }

        if (loanGranted == (decimal)100.00)
        {
            loan100 ++;
        }
    }



}
<script src="https://www.gstatic.com/charts/loader.js">
</script>

<div id="IndexId" class="text-black-50 text-center " style="margin-top:50px;">
    <h6 class="display-4 GlassBackGround">
        Home Loans

      
    </h6>
    <div class="container-fluid">
        <!--Row 1 charts-->
        <div class="row">
    
        <div class="col-12 col-md-6 chartGlassBg">
           <div class="chart-container" text-white" id="chart" style="height:380px;"> </div>
        </div>

            <div class="col-12 col-md-6 chartGlassBg">
                <div class="chart-container" text-white" id="lineGraphDiv" style="height:380px;"> </div>
            </div>


        </div>
        <!--End of Row 1 Charts-->

        <!-- Row 2 Charts-->
        <div class="row">
            <div class="col-lg-6 mb-4 chartGlassBg">
            <div id="barChart" style="height:380px;"></div>
        </div>
        </div>
        <!--End of Row 2 Charts -->

    </div>

</div>




<script>
    google.charts.load('current',{'packages':
    ['corechart']});
    google.charts.setOnLoadCallback(drawChart);

    window.addEventListener('resize',drawChart);

    //Mother Function for Charts start
    function drawChart()
    {
      
        threeDchart();
        barCahrt();
        lineGraph();
    }
    //Mother Function for Charts end

    //3D Pie Chart start
    function threeDchart()
    {
          const data = google.visualization.arrayToDataTable(
       [     ['Contry','Loop'],
            ['Accepted Loans',@acceptedLoans],
            ['Rejected Loans',@rejectedLoans]
       ] );

       const options = {title:'Home Loan Stats ('+@noOfLoans+')',
       is3D:true,
       backgroundColor:{fill:'transparent'}};

           // Draw
    const chart = new google.visualization.PieChart(document.getElementById('chart'));
    chart.draw(data, options);
    }
    //3D Pie Chart End 

    //Bar Graph Start
    function barCahrt()
    {
         const data=google.visualization.arrayToDataTable([

        ['Loans Percentages','Loans Granted'],

        ['80%',@loan80],
        ['85%',@loan85],
        ['90%',@loan90],
        ['95%',@loan95],
        ['97.5%',@loan97],
        ['100%',@loan100]

    ]);

     const options={
        title:'Loan Percentiles vs Loans Granted',
        backgroundColor:'transparent',
        legend:{position:'none'} };

        var chart=new google.visualization.ColumnChart(document.getElementById('barChart'));

        chart.draw(data,options);

    }
    //Bar Graph End 


    //Line Graph stuff
      var charLineGPdata = [['Gross Salary', 'Loan Granted']];

    @foreach (var item in Model)
    {
            <text>
                        charLineGPdata.push([
            @item.GrossSalary.ToString(System.Globalization.CultureInfo.InvariantCulture),
            @item.LoanGranted.ToString(System.Globalization.CultureInfo.InvariantCulture)
        ]);
            </text>
    }

    console.log('charLineGPdata:', charLineGPdata);
   // console.log(google);
    
    
    function lineGraph()
    {

    const data = google.visualization.arrayToDataTable(charLineGPdata);
        const options = {
            title: 'Gross Salary vs Loan Granted',
            backgroundColor: 'transparent',
            legend: { position: 'none' },
            hAxis: { title: 'Gross Salary' },
            vAxis: { title: 'Loan Granted' }
        };
        const chart = new google.visualization.LineChart(document.getElementById('lineGraphDiv'));
        chart.draw(data, options);

    }
    //Line graph stuff end 


</script>
















