@{
    ViewData["Title"] = "Home Page";

    var rejectedLoans = TempData["rejectedLoans"];
    TempData.Keep("rejectedLoans");
    var acceptedLoans = TempData["acceptedLoans"];
    TempData.Keep("acceptedLoans");
    var noOfLoans = TempData["noOfLoans"];
    TempData.Keep("noOfLoans");


    /*Granted Loans Stats*/
    int loan80 = 0,
    loan85 = 0,
    loan90 = 0,
    loan95 = 0,
    loan97 = 0,
    loan100 = 0;


    foreach (var loanGranted in ViewBag.loansAllocated)
    {
        if(loanGranted == (decimal)80.00)
        {
            loan80 ++;
        }

        if (loanGranted == (decimal)85.00)
        {
            loan85 ++;
        }

        if (loanGranted == (decimal)90.00)
        {
            loan90 ++;
        }

        if (loanGranted == (decimal)95.00)
        {
            loan95 ++;
        }

        if (loanGranted == (decimal)97.5)
        {
            loan97 ++;
        }

        if (loanGranted == (decimal)100.00)
        {
            loan100 ++;
        }
    }


}
<script src="https://www.gstatic.com/charts/loader.js">
</script>

<div id="IndexId" class="text-black-50 text-center " style="margin-top:50px;">
    <h6 class="display-4 GlassBackGround">
        Home Loans

      
    </h6>
    <div class="container-fluid">
    <div class="col-12 col-md-6">
            <div class="chart-container" text-white" id="chart" style="height:400px;">
        </div>
    </div>
        <div class="col-lg-6 mb-4">
            <div id="barChart" style="height:400px;"></div>
        </div>
    </div>

</div>




<script>
    google.charts.load('current',{'packages':
    ['corechart']});
    google.charts.setOnLoadCallback(drawChart);

    window.addEventListener('resize',drawChart);

    function drawChart()
    {
      
        threeDchart();
        barCahrt();
    }

    function threeDchart()
    {
          const data = google.visualization.arrayToDataTable(
       [     ['Contry','Loop'],
            ['Accepted Loans',@acceptedLoans],
            ['Rejected Loans',@rejectedLoans]
       ] );

       const options = {title:'Home Loan Stats ('+@noOfLoans+')',
       is3D:true,
       backgroundColor:{fill:'transparent'}};

           // Draw
    const chart = new google.visualization.PieChart(document.getElementById('chart'));
    chart.draw(data, options);
    }

    function barCahrt()
    {
         const data=google.visualization.arrayToDataTable([

        ['Loans Percentages','Loans Granted'],

        ['80%',@loan80],
        ['85%',@loan85],
        ['90%',@loan90],
        ['95%',@loan95],
        ['97.5%',@loan97],
        ['100%',@loan100]

    ]);

     const options={
        title:'Loan Percentiles vs Loans Granted',
        backgroundColor:'transparent',
        legend:{position:'none'} };

        var chart=new google.visualization.ColumnChart(document.getElementById('barChart'));

        chart.draw(data,options);

    }


</script>
















